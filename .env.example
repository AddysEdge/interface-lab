# Copy to .env.local and fill in your own configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key only. Never place a service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_KEY=
# Optional HTTPS hostname only, without scheme or path:
COMPONENT_IMAGE_HOST=
